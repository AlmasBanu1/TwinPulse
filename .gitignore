# ==============================
# TwinPulse - Git Ignore Rules
# ==============================

# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Machine Learning artifacts
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.onnx

# Local datasets
data/raw/
data/processed/
data/external/

# Large generated files
*.csv
*.parquet
*.feather
*.npy
*.npz

# Logs
*.log
logs/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output
dist/
build/

# Coverage
coverage/

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Local databases
*.db
*.sqlite
*.sqlite3